{
  "name": "bloomai-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
   "dev": "concurrently -k \"npm:api\" \"npm:ui\"",
    "api": "nodemon --watch src --ext ts --exec ts-node src/index.ts",       
    "ui": "cross-env NEXT_PUBLIC_API_BASE=http://localhost:4000 npm run dev --prefix ./bloomai-ui",

    "build": "npm run build:api && npm run build:ui",
    "build:api": "tsc -p tsconfig.json",
    "build:ui": "npm run build --prefix ./bloomai-ui",

    "start": "concurrently -k \"npm:api:start\" \"npm:ui:start\"",
    "api:start": "node dist/index.js",
    "ui:start": "cross-env NEXT_PUBLIC_API_BASE=http://localhost:4000 npm start --prefix ./bloomai-ui"
  }
  ,
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "next": "16.0.0"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.0.0"
  }
}
